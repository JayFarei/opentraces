STATS_API_BASE_URL=https://opentraces-metrics.<your-subdomain>.workers.dev

# --- Early-access waitlist (/api/waitlist) ---
# Production storage is Redis via the Vercel Marketplace (Upstash for Redis).
# Provision it from the project's Storage tab (or `vercel integration add upstash`)
# and connect it to the project — the integration injects these automatically;
# you do not set them by hand. The code also accepts the UPSTASH_REDIS_REST_*
# prefix if your integration uses that instead. Without any of them, dev falls
# back to a local .data/waitlist.json file; production returns 503 until provisioned.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (alternative prefix, also supported)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Token gating the admin read. Preferred call (keeps the secret out of logs):
#   curl -H "Authorization: Bearer <this>" https://opentraces.ai/api/waitlist
# A ?token=<this> query param also works as a fallback. Pick any long random
# string and set it in the Vercel project's Environment Variables.
WAITLIST_ADMIN_TOKEN=

# Optional: per-IP submissions allowed per hour before 429. Defaults to 5.
WAITLIST_RATE_LIMIT=5

# Optional: Slack Incoming Webhook URL. When set, each NEW waitlist signup posts
# a message to the webhook's channel. Best-effort — a Slack failure never blocks
# a signup, and leaving this unset disables notifications silently.
# Create one at: Slack -> your workspace app -> Incoming Webhooks -> Add New
# Webhook to Workspace, then paste the https://hooks.slack.com/services/... URL.
SLACK_WAITLIST_WEBHOOK_URL=
