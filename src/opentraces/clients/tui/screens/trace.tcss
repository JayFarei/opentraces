/* ── TraceScreen layout ──────────────────────────────────────────── */
/* Two-panel: transcript (left) + analysis sidebar (right)            */
/* Design tokens (duplicated from app.tcss, needed for screen CSS)    */

$ot_primary: #F97316;
$ot_secondary: #22D3EE;
$ot_accent: #22C55E;
$ot_background: #111111;
$ot_foreground: #E0E0E0;
$ot_muted: #666666;
$ot_dim: #444444;
$ot_blue: #3B82F6;
$ot_surface: #191919;
$ot_border: #2A2A2A;

#trace-shell {
    height: 1fr;
    width: 1fr;
}

#trace-topbar {
    height: 1;
    padding: 0 1;
    background: $ot_surface;
    color: $ot_foreground;
}

#trace-workspace {
    height: 1fr;
}

/* ── Transcript panel ────────────────────────────────────────────── */

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 1 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $ot_dim;
    scrollbar-color-hover: $ot_primary;
    scrollbar-color-active: $ot_primary;
    scrollbar-background: $ot_background;
    scrollbar-background-hover: $ot_background;
    scrollbar-background-active: $ot_background;
}

#transcript > .trace-step {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 0 1 0 1;
    background: $ot_background;
    border-left: tall transparent;
}

#transcript > .trace-step.user-message {
    background: transparent;
    border-left: tall $ot_blue;
}

#transcript > .trace-step.agent-message {
    background: $ot_background;
}

#transcript > .trace-step.system-message {
    background: #151515;
    border-left: tall $ot_border;
}

#transcript > .trace-step.-selected {
    background: #1D1D1D;
    border-left: tall $ot_primary;
}

#transcript > .trace-step.user-message.-selected {
    background: transparent;
    border-left: tall $ot_blue;
}

#transcript > .trace-step.subagent-step {
    margin-left: 3;
    border-left: tall $ot_secondary;
}

#transcript > .trace-step.subagent-step.-selected {
    border-left: tall $ot_secondary;
    background: #1D1D1D;
}

.step-header {
    height: auto;
    margin: 0 0 0 0;
}

.step-content {
    height: auto;
    margin: 0;
    padding: 0;
}

.step-preview {
    height: auto;
    margin: 0;
    padding: 0;
}

.step-hint {
    height: auto;
    margin: 0;
    padding: 0;
}

.step-thinking {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 0 0 2;
    border-left: tall $ot_dim;
    opacity: 60%;
}

/* ToolCallBlock (Vertical container) */
.tool-call-block {
    background: $ot_surface;
    padding: 0 1;
    margin: 0 0 0 2;
    height: auto;
    border-left: tall $ot_accent;
}

.tool-call-block.-expanded {
    padding: 1 1;
}

/* Inner Statics (collapsed/expanded views) */
.tool-call-collapsed,
.tool-call-expanded {
    height: auto;
    margin: 0;
    padding: 0;
}

/* ── Sidebar (always visible) ────────────────────────────────────── */

#sidebar {
    width: 42;
    min-width: 34;
    background: $ot_surface;
    border-left: solid $ot_border;
}

#sidebar-summary {
    height: auto;
    max-height: 12;
    padding: 1 0 0 0;
}

#step-index {
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-color: $ot_dim;
    scrollbar-color-hover: $ot_primary;
    scrollbar-background: $ot_surface;
    scrollbar-background-hover: $ot_surface;
}

#step-index > .list-item {
    height: 1;
    padding: 0 1;
    background: $ot_surface;
    color: $ot_foreground;
}

#step-index > .list-item:hover {
    background: #222222;
}

#step-index > .list-item.-highlight {
    background: #F97316 15%;
}

#step-index:focus > .list-item.-highlight {
    background: #F97316 20%;
}

/* ── Jump input ──────────────────────────────────────────────────── */

#jump-bar {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $ot_surface;
}

#jump-bar #jump-input {
    width: 20;
    height: 1;
    border: none;
    background: $ot_surface;
    color: $ot_foreground;
}

/* ── Help overlay ───────────────────────────────────────────────── */

#help-overlay {
    layer: overlay;
    width: 64;
    height: auto;
    max-height: 22;
    align: center middle;
    background: $ot_surface;
    border: tall $ot_secondary;
    padding: 1 2;
    display: none;
}
